{% raw %}<div class="statblock" markdown="0">
  <hr class="statblock-orange-border-top" />
  <div class="statblock-section-left">
    <div class="statblock-creature-heading">
      <h1>{{ sb.name | default("Unnamed", true) }}</h1>
      <h2>{{ [sb.size, sb.type, sb.subtype and "(" ~ sb.subtype ~ ")" or ""] | select | join(" ") }}{% if sb.alignment %}, {{ sb.alignment }}{% endif %}</h2>
    </div>

    <svg height="5" width="100%" class="statblock-tapered-rule"><polyline points="0,0 400,2.5 0,5"></polyline></svg>

    <div class="statblock-property-line">
      <h4>Armor Class</h4> <p>{{ sb.ac | default("—", true) }}{% if sb.ac_type %} ({{ sb.ac_type }}){% endif %}</p>
    </div>
    <div class="statblock-property-line">
      <h4>Hit Points</h4> <p>{{ sb.hp | default("—", true) }}{% if sb.hit_dice %} ({{ sb.hit_dice }}){% endif %}</p>
    </div>
    <div class="statblock-property-line">
      <h4>Speed</h4> <p>{{ sb.speed | default("—", true) }}</p>
    </div>

    <svg height="5" width="100%" class="statblock-tapered-rule"><polyline points="0,0 400,2.5 0,5"></polyline></svg>

    <div class="statblock-abilities">
      {% for key, label in [("str","STR"),("dex","DEX"),("con","CON"),("int","INT"),("wis","WIS"),("cha","CHA")] %}
      <div class="statblock-ability">
        <h4>{{ label }}</h4>
        <p>{{ sb[key] | default("—", true) }} ({{ mod(sb[key]) }})</p>
      </div>
      {% endfor %}
    </div>

    <svg height="5" width="100%" class="statblock-tapered-rule"><polyline points="0,0 400,2.5 0,5"></polyline></svg>

    {% if sb.saves %}<div class="statblock-property-line"><h4>Saving Throws</h4> <p>{{ sb.saves }}</p></div>{% endif %}
    {% if sb.skills %}<div class="statblock-property-line"><h4>Skills</h4> <p>{{ sb.skills }}</p></div>{% endif %}
    {% if sb.damage_vulnerabilities %}<div class="statblock-property-line"><h4>Damage Vulnerabilities</h4> <p>{{ sb.damage_vulnerabilities }}</p></div>{% endif %}
    {% if sb.damage_resistances %}<div class="statblock-property-line"><h4>Damage Resistances</h4> <p>{{ sb.damage_resistances }}</p></div>{% endif %}
    {% if sb.damage_immunities %}<div class="statblock-property-line"><h4>Damage Immunities</h4> <p>{{ sb.damage_immunities }}</p></div>{% endif %}
    {% if sb.condition_immunities %}<div class="statblock-property-line"><h4>Condition Immunities</h4> <p>{{ sb.condition_immunities }}</p></div>{% endif %}
    {% if sb.senses %}<div class="statblock-property-line"><h4>Senses</h4> <p>{{ sb.senses }}</p></div>{% endif %}
    {% if sb.languages %}<div class="statblock-property-line"><h4>Languages</h4> <p>{{ sb.languages }}</p></div>{% endif %}
    {% if sb.cr is not none %}<div class="statblock-property-line"><h4>Challenge</h4> <p>{{ sb.cr }}{% if sb.xp %} ({{ sb.xp }} XP){% endif %}</p></div>{% endif %}

    <svg height="5" width="100%" class="statblock-tapered-rule"><polyline points="0,0 400,2.5 0,5"></polyline></svg>

    {% for trait in as_list(sb.traits) %}
    <div class="statblock-property-block">
      <h4>{{ trait.name }}.</h4> <p>{{ trait.desc }}</p>
    </div>
    {% endfor %}

    {% if sb.actions %}
    <div class="statblock-actions">
      <h3>Actions</h3>
      {% for action in as_list(sb.actions) %}
      <div class="statblock-property-block">
        <h4>{{ action.name }}.</h4> <p>{{ action.desc }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if sb.bonus_actions %}
    <div class="statblock-actions">
      <h3>Bonus Actions</h3>
      {% for action in as_list(sb.bonus_actions) %}
      <div class="statblock-property-block">
        <h4>{{ action.name }}.</h4> <p>{{ action.desc }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if sb.reactions %}
    <div class="statblock-actions">
      <h3>Reactions</h3>
      {% for action in as_list(sb.reactions) %}
      <div class="statblock-property-block">
        <h4>{{ action.name }}.</h4> <p>{{ action.desc }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if sb.legendary_actions %}
    <div class="statblock-actions">
      <h3>Legendary Actions</h3>
      {% if sb.legendary_desc %}<p>{{ sb.legendary_desc }}</p>{% endif %}
      {% for action in as_list(sb.legendary_actions) %}
      <div class="statblock-property-block">
        <h4>{{ action.name }}.</h4> <p>{{ action.desc }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  <hr class="statblock-orange-border-bottom" />
</div>{% endraw %}
